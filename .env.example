APP_ENV=local

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_platform
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_TOKEN=replace-with-a-long-random-internal-token

# bcrypt cost (4-14, default 10 if unset)
# Existing hashes with lower cost are auto-rehashed on successful login.
BCRYPT_COST=10

# DB pool sizing (tuned for 1k+ QPS)
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=25

# Rate limiting (req/s). Defaults if unset: auth=5, ip=60, user=100
RATELIMIT_AUTH_RATE=5
RATELIMIT_AUTH_BURST=10
RATELIMIT_IP_RATE=60
RATELIMIT_IP_BURST=100
RATELIMIT_USER_RATE=100
RATELIMIT_USER_BURST=200

