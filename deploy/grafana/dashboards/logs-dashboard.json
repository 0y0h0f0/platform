      "targets": [
        {
          "expr": "topk(10, sum by (path, status) (count_over_time({service=\"api-gateway\"} | json | msg = `access` | unwrap latency [$__interval])))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Top 10 Request Paths by Status",
      "type": "table"
    },
