          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Requests by Status (API Gateway)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
